# Copy this file to .env and adjust for your environment.
# .env is never committed to version control — see .gitignore.
# If no .env file is present, the app falls back to the XAMPP defaults
# already hard-coded in config/database.php, so local development still
# works with zero setup.

APP_ENV=local
# local  -> show PHP errors on screen, useful while developing
# production -> hide errors from users, log them to storage/logs/error.log instead

DB_HOST=localhost
DB_NAME=pms_db
DB_USER=root
DB_PASS=

# Set to 1 only when serving the app over HTTPS. When on, session cookies
# are marked Secure and will NOT be sent over plain HTTP.
FORCE_HTTPS=0
